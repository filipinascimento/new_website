{
  "name": "filipi-nascimento-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "vendor:helios": "node scripts/vendor-helios.mjs",
    "data:openalex": "node scripts/fetch-openalex.mjs",
    "data:scholar": "node scripts/fetch-scholar-metrics.mjs",
    "data:compare": "node scripts/compare-publication-sources.mjs",
    "data:github": "node scripts/fetch-github.mjs",
    "data:figures": "node scripts/fetch-publication-figures.mjs",
    "figures:projects": "node scripts/build-project-thumbnails.mjs",
    "data:refresh": "npm run data:scholar && npm run data:openalex && npm run data:compare && npm run data:github && npm run data:figures && npm run content:build",
    "predev": "npm run content:build && npm run vendor:helios",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run content:build && npm run vendor:helios",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:github": "GITHUB_PAGES=true npm run content:build && npm run vendor:helios && GITHUB_PAGES=true next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run content:build && node --test tests/site.test.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run build:github",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/vendor"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "gray-matter": "^4.0.3",
    "helios-network": "^0.10.4",
    "helios-web": "^0.10.9",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
